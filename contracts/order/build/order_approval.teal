    dup; pushint 80; box_create; assert                     // create & assert created
    store 22                                                // box:order
    
    // Assertions
    // tl:204: assert(amount > 0)
    load 18                                                 // amount
    pushint 0
    >
    assert
    // tl:205: assert(target_amount > 0)
    load 16                                                 // target_amount
    pushint 0
    >
    assert
    // tl:206: assert(asset_id != target_asset_id)
    load 19                                                 // asset_id
    load 17                                                 // target_asset_id
    !=
    assert
    
    // tl:208: int expiration_timestamp [slot 23]
    // tl:209: if !duration:
    load 14                                                 // duration
    !
    bz l1_else
    // then:
        // tl:210: expiration_timestamp = MAX_UINT64
        pushint MAX_UINT64                                  // 18446744073709551615
        store 23                                            // expiration_timestamp
        b l1_end
    l1_else:
    // tl:211: else:
        // tl:212: expiration_timestamp = Global.LatestTimestamp + duration
        global LatestTimestamp
        load 14                                             // duration
        +
        store 23                                            // expiration_timestamp
    l1_end:
    
    // tl:215: if target_asset_id:
    load 17                                                 // target_asset_id
    bz l2_end
    // then:
        // tl:216: int is_opted_in_to_target [slot 24]
        // tl:217: is_opted_in_to_target, _ = asset_holding_get(AssetBalance, Global.CurrentApplicationAddress, target_asset_id)
        global CurrentApplicationAddress
